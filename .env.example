# --- Payments (Stripe), TK-131 ---
# Copy to .env (git-ignored). Names and placeholders only: never commit a real key.
# Production/test: keep STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET in the host's secret store.

# Feature switch for drop-in payments. Default: false. Set to true only after US-132, US-133 and US-134 are deployed.
# When true, every Stripe and drop-in price variable below is required.
PAYMENTS_ENABLED=false

# Secret. Restricted key recommended (PaymentIntents: Write, Refunds: Write, Charges: Read). Required when PAYMENTS_ENABLED=true.
# STRIPE_SECRET_KEY=sk_test_...

# Not secret (returned to the SPA). Required when PAYMENTS_ENABLED=true. Must be the same mode as the secret key.
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret. Signing secret of this environment's webhook endpoint. Required when PAYMENTS_ENABLED=true.
# Locally: run `stripe listen --forward-to localhost:3000/webhooks/stripe` and use the printed whsec_ value.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Must be true to accept live keys. Default: false. Set in production only.
# STRIPE_LIVE_MODE_ALLOWED=false

# Per-request timeout for Stripe calls in ms (1000-30000). Default: 10000.
# STRIPE_TIMEOUT_MS=10000

# Drop-in price in minor units, e.g. cents (1-99999999). Value from the PO. Required when PAYMENTS_ENABLED=true.
# DROP_IN_PRICE_AMOUNT=<amount in minor units>

# ISO 4217 currency code (3 letters, stored in lower case). Value from the PO. Required when PAYMENTS_ENABLED=true.
# DROP_IN_CURRENCY=<code>

# --- Payment retry and hold when Stripe is unavailable, US-133 ---
# Defaults are assumptions pending the PO. Only read when PAYMENTS_ENABLED=true.

# Base of the exponential backoff in seconds (10-3600). Wait before retry n = base x 2^(n-1). Default: 60.
# PAYMENT_RETRY_BASE_SECONDS=60

# Total create-intent attempts including the first (1-10). Default: 5.
# PAYMENT_RETRY_MAX_ATTEMPTS=5

# How long a pending_payment booking keeps its place, from booking time and never beyond the class start (5-720). Default: 30.
# PAYMENT_HOLD_MINUTES=30

# Interval of the payment-maintenance job in seconds (10-600). Default: 30.
# PAYMENT_JOB_INTERVAL_SECONDS=30
