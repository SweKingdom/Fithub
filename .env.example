# --- Database and server ---
# Copy to .env (git-ignored). The values below match docker-compose.yml (local development only).

# PostgreSQL connection used by the API, `npm run db:migrate` and the operator commands.
DATABASE_URL=postgres://fithub:fithub@localhost:5432/fithub

# Database for the integration tests. Its name must end with _test, otherwise the tests refuse to run.
# When not set, the tests use DATABASE_URL (as in CI, where it points to fithub_test).
TEST_DATABASE_URL=postgres://fithub:fithub@localhost:5432/fithub_test

# Port and address of the API (defaults: 3000 and 0.0.0.0) and the log level (default: info).
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info

# --- Sign-in and sessions, US-118 ---
# All optional locally; defaults are shown. In production APP_ORIGIN is required and the cookie must be Secure.

# Origin of the web app (scheme + host [+ port], no path, no trailing slash). State-changing requests from any
# other origin are refused. Required when NODE_ENV=production.
# APP_ORIGIN=http://localhost:5173

# Send the session cookie over HTTPS only. Default: true when NODE_ENV=production, otherwise false. Must be true in production.
# SESSION_COOKIE_SECURE=false

# A session ends after this many minutes without activity (integer, at least 5). Default: 720 (12 hours).
# SESSION_IDLE_TIMEOUT_MINUTES=720

# A session ends this many hours after sign-in, whatever the activity (integer, at least 1). Default: 168 (7 days).
# SESSION_MAX_AGE_HOURS=168

# scrypt cost N for new password hashes: a power of two, at least 16384. Default: 131072. Tests and CI use 16384.
# AUTH_SCRYPT_COST=131072

# Sign-in attempts allowed per email and IP address within the window; the next one gets 429. Defaults: 10 per 15 minutes.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Set to true behind a reverse proxy or load balancer so the limit uses the client's IP address. Default: false.
# TRUST_PROXY=false

# --- Waiting list and background jobs, US-128 ---
# Assumptions until the product owner decides; the defaults below apply when the variables are not set.

# Minutes before the class start from which nobody is promoted from the waiting list (and joining closes).
# Integer, at least 0. Default: 0 (promote until the class starts). Remaining waiting entries expire at the cut-off.
# WAITLIST_PROMOTION_CUTOFF_MINUTES=0

# How often the waitlist-maintenance job runs (expires entries, promotes into free places that were missed).
# Integer, at least 10. Default: 60.
# WAITLIST_JOB_INTERVAL_SECONDS=60

# Run the in-process background jobs (true or false). Default: true, but false when NODE_ENV=test.
# Keep true on the API instances; several instances are safe.
# JOBS_ENABLED=true

# --- No-show block, US-130 ---
# A member whose uncounted no-shows in the window reach the threshold cannot book for the block length.
# The defaults are provisional until the product owner confirms them. Changing a value affects only future
# decisions; existing blocks are not recalculated.

# Number of uncounted no-shows in the window that creates a block (integer, 1-20). Default: 3.
# NO_SHOW_THRESHOLD=3

# How "a month" is counted: rolling_days (the last NO_SHOW_WINDOW_DAYS days) or calendar_month (the current
# calendar month in the member's home club time zone). Default: rolling_days.
# NO_SHOW_WINDOW=rolling_days

# Length of the rolling window in days (integer, 1-366); only used with rolling_days. Default: 30.
# NO_SHOW_WINDOW_DAYS=30

# How long a block lasts in days (integer, 1-90). Default: 7.
# NO_SHOW_BLOCK_DAYS=7

# --- Payments (Stripe), TK-131 ---
# Names and placeholders only: never commit a real key.
# Production/test: keep STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET in the host's secret store.

# Feature switch for drop-in payments. Default: false. Set to true only after US-132, US-133 and US-134 are deployed.
# When true, every Stripe and drop-in price variable below is required.
PAYMENTS_ENABLED=false

# Secret. Restricted key recommended (PaymentIntents: Write, Refunds: Write, Charges: Read). Required when PAYMENTS_ENABLED=true.
# STRIPE_SECRET_KEY=sk_test_...

# Not secret (returned to the SPA). Required when PAYMENTS_ENABLED=true. Must be the same mode as the secret key.
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret. Signing secret of this environment's webhook endpoint. Required when PAYMENTS_ENABLED=true.
# Locally: run `stripe listen --forward-to localhost:3000/webhooks/stripe` and use the printed whsec_ value.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Must be true to accept live keys. Default: false. Set in production only.
# STRIPE_LIVE_MODE_ALLOWED=false

# Per-request timeout for Stripe calls in ms (1000-30000). Default: 10000.
# STRIPE_TIMEOUT_MS=10000

# Drop-in price in minor units, e.g. cents (1-99999999). Value from the PO. Required when PAYMENTS_ENABLED=true.
# DROP_IN_PRICE_AMOUNT=<amount in minor units>

# ISO 4217 currency code (3 letters, stored in lower case). Value from the PO. Required when PAYMENTS_ENABLED=true.
# DROP_IN_CURRENCY=<code>

# Minutes a drop-in booking holds its place while unpaid (1-1440), counted from the booking time and never past
# the class start. Default: 30 (US-132).
# PAYMENT_HOLD_MINUTES=30
