{
  "name": "@fithub/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts up",
    "db:migrate:down": "tsx --env-file-if-exists=../.env src/db/migrate.ts down"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.4",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4"
  }
}
