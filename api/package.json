{
  "name": "@fithub/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:migrate": "node --env-file-if-exists=../.env --import tsx src/db/migrate.ts",
    "db:seed:clubs": "node --env-file-if-exists=../.env --import tsx scripts/seed-clubs.ts",
    "user:create": "node --env-file-if-exists=../.env --import tsx scripts/user-admin.ts create",
    "user:set-password": "node --env-file-if-exists=../.env --import tsx scripts/user-admin.ts set-password",
    "import:members": "node --env-file-if-exists=../.env --import tsx scripts/import-members.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^2.1.5"
  }
}
