{
  "name": "fithub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9 <23"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces",
    "db:migrate": "npm run db:migrate -w api",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run db:migrate && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
